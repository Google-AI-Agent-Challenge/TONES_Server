# App Config
PROJECT_NAME="TONES Server"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-key-change-this-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# GCP Config & Cloud SQL Config
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="us-central1"
CLOUD_SQL_CONNECTION_NAME="your-cloud-sql-connection-name"
DB_USER="postgres"
DB_PASS="your-db-password"
DB_NAME="postgres"
DB_HOST="localhost"
DB_PORT=5432

# Sentry Config
SENTRY_DSN=""

# Google Gemini Config
GEMINI_API_KEY="your-gemini-api-key"

# Google Docs API Config
# GCP 서비스 계정 JSON 키를 한 줄 JSON 문자열로 입력 (예: '{"type":"service_account","project_id":"...","private_key":"..."}')
GOOGLE_SERVICE_ACCOUNT_JSON='your-service-account-json-string'